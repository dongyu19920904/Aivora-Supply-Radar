{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aivora-supply-radar",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SITE_URL": "https://supply.aivora.cn",
    "SOURCE_REPO": "dongyu19920904/Aivora-Supply-Radar"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RADAR",
        "class_name": "SupplyRadarStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SupplyRadarStore"]
    }
  ]
}
