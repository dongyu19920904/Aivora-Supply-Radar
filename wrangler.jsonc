{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aivora-supply-radar",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SITE_URL": "https://supply.aivora.cn",
    "SOURCE_REPO": "dongyu19920904/Hextra-AI-Insight-Daily"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RADAR",
        "class_name": "SupplyRadarStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SupplyRadarStore"]
    }
  ],
  "triggers": {
    "crons": ["17 2 * * *", "47 */6 * * *"]
  },
  "routes": [
    {
      "pattern": "supply.aivora.cn",
      "custom_domain": true
    }
  ]
}
