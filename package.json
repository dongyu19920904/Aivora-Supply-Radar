{
  "name": "aivora-supply-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "lint": "biome check src tests scripts pages-edge",
    "lint:fix": "biome check --write src tests scripts pages-edge",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dry-run:seed": "tsx scripts/dry-run-seed.ts",
    "dry-run:opportunity": "tsx scripts/dry-run-opportunity.ts",
    "check:content": "tsx scripts/check-content.ts",
    "check:live-sources": "tsx scripts/check-live-sources.ts",
    "audit:competitive": "tsx scripts/competitive-site-audit.ts",
    "audit:priceai-parity": "tsx scripts/priceai-parity-audit.ts",
    "audit:release-ui": "tsx scripts/release-ui-audit.ts",
    "audit:visual": "tsx scripts/visual-audit.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@cloudflare/workers-types": "^5.20260828.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.127.1"
  }
}
