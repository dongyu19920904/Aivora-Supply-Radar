{
  "name": "@aivora/supply-radar-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "import:legacy": "tsx scripts/import-legacy-baseline.ts",
    "import:account-opportunity-archive": "tsx scripts/import-account-opportunity-archive.ts",
    "import:priceai": "tsx scripts/import-priceai-snapshot.ts",
    "audit:data": "tsx scripts/audit-supabase-snapshot.ts",
    "audit:visual": "tsx scripts/visual-audit.ts",
    "build:cf": "opennextjs-cloudflare build",
    "build:cf:preview": "opennextjs-cloudflare build --config wrangler.preview.toml --openNextConfigPath open-next.static-assets.config.ts",
    "bundle:cf:preview": "opennextjs-cloudflare build --skipNextBuild --config wrangler.preview.toml --openNextConfigPath open-next.static-assets.config.ts",
    "build:cf:production": "opennextjs-cloudflare build --config wrangler.production.toml --openNextConfigPath open-next.static-assets.config.ts",
    "bundle:cf:production": "opennextjs-cloudflare build --skipNextBuild --config wrangler.production.toml --openNextConfigPath open-next.static-assets.config.ts",
    "preview:cf": "pnpm build:cf && opennextjs-cloudflare preview",
    "deploy:cf": "pnpm build:cf && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@next/third-parties": "^16.3.0",
    "@notionhq/client": "^2.2.15",
    "@supabase/supabase-js": "^2.110.3",
    "@tailwindcss/typography": "^0.5.20",
    "canvas-confetti": "1.9.4",
    "date-fns": "3.6.0",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next": "^16.3.0",
    "nextjs-toploader": "^3.9.17",
    "notion-to-md": "^3.1.9",
    "react": "19.2.8",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-responsive-masonry": "2.7.1",
    "react-slick": "0.31.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.26",
    "supabase": "^2.75.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "wrangler": "^4.119.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5",
      "undici": "7.29.0",
      "nanoid": "3.3.17"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase",
      "workerd"
    ]
  }
}
